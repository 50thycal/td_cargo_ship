{
  "name": "straitwatch",
  "private": true,
  "version": "0.1.0",
  "description": "Straitwatch — adaptive convoy-defense game MVP (predator vs prey arms race)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/smoke.mjs",
    "playtest": "vite-node tools/playtest/run.ts --",
    "ablate": "vite-node tools/playtest/ablate.ts --",
    "fidelity": "vite-node tools/playtest/fidelity.ts --",
    "e2e:workshop": "node e2e/workshop.mjs",
    "dev:v2": "vite --open /v2.html",
    "v2:sweep": "vite-node tools/v2/sweep.ts --",
    "e2e:v2": "node e2e/v2.mjs",
    "v2:replay": "vite-node tools/v2/replay.ts --",
    "e2e:v2:log": "node e2e/v2-vercel-log.mjs",
    "e2e:v2:watch": "node e2e/v2-watch.mjs",
    "v2:analyze": "vite-node tools/v2/analyze.ts --",
    "v2:formation-lab": "vite-node tools/v2/formation-lab.ts --",
    "v2:audit": "vite-node tools/v2/audit.ts --",
    "v2:style": "vite-node tools/v2/style.ts --",
    "v2:fit": "vite-node tools/v2/fit.ts --",
    "v2:moment": "node tools/v2/moment.mjs",
    "v2:cards": "vite-node tools/v2/card-sheet.ts --"
  },
  "devDependencies": {
    "playwright-core": "^1.49.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2"
  }
}
